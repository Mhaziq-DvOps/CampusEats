<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
function updateTotals() {
    let total = 0;

    $('.basket-product').each(function () {
        const price = parseFloat($(this).find('.price').data('price'));
        const quantity = parseInt($(this).find('.quantity-field').val());
        const subtotal = price * quantity;

        $(this).find('.subtotal').text(subtotal.toFixed(2));
        total += subtotal;
    });

    $('.total-price').text(total.toFixed(2));
}

function incrementValue(e) {
    e.preventDefault();
    const parent = $(e.target).closest('.input-group');
    const quantityField = parent.find('.quantity-field');
    let currentVal = parseInt(quantityField.val());

    if (!isNaN(currentVal) && currentVal < 10) {
        quantityField.val(currentVal + 1);
    } else {
        quantityField.val(1);
    }
    updateTotals();
}

function decrementValue(e) {
    e.preventDefault();
    const parent = $(e.target).closest('.input-group');
    const quantityField = parent.find('.quantity-field');
    let currentVal = parseInt(quantityField.val());

    if (!isNaN(currentVal) && currentVal > 1) {
        quantityField.val(currentVal - 1);
    } else {
        quantityField.val(1);
    }
    updateTotals();
}

$(document).ready(function () {
    $('.input-group').on('click', '.button-plus', incrementValue);
    $('.input-group').on('click', '.button-minus', decrementValue);

    $('.quantity-field').on('change', function () {
        let val = parseInt($(this).val());
        if (isNaN(val) || val < 1) {
            $(this).val(1);
        } else if (val > 10) {
            $(this).val(10);
        }
        updateTotals();
    });

    // Initial calculation
    updateTotals();
});
</script>
